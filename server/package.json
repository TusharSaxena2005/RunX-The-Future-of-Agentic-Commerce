{
  "name": "ai-commerce-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "prisma db seed",
    "db:seed-demo-activity": "node prisma/seed-demo-activity.js",
    "db:update-catalog": "node prisma/update-catalog.js",
    "db:add-comparisons": "node prisma/add-comparison-products.js",
    "db:reset-demo": "node prisma/reset-demo.js",
    "test": "node --test test/safety.test.js test/shopping.test.js test/kpi.test.js",
    "test:integration": "node --test test/integration.test.js",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "prisma": "^6.15.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
